{
  "manifest_version": 3,
  "name": "JSON Formatter (2-space)",
  "version": "1.0",
  "description": "Formats JSON in the browser with configurable indents, indent guides, line numbers, collapsible nodes and one-click copy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    { "resources": ["JetBrainsMono.woff2"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
